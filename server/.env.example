# ─────────────── Serveur de jeu (Node.js + Socket.IO) ───────────────
# En local : copie ce fichier en `server/.env` (chargé automatiquement par `npm run dev`).
# En production (Render…) : saisis ces variables dans les réglages de l'hébergeur.

# Port d'écoute. Render le fournit tout seul : ne le définis pas là-bas.
PORT=3001

# « production » en ligne. En local, laisse vide.
NODE_ENV=

# Adresse(s) du site autorisées à se connecter (CORS + WebSocket), séparées par des virgules,
# sans barre oblique finale. Jokers acceptés pour les sous-domaines.
#   Exemple : https://griboulade.pages.dev,https://*.griboulade.pages.dev
# En local, les valeurs par défaut (http://localhost:5173) conviennent : laisse vide.
# Inutile si le serveur sert lui-même le site (mode « tout-en-un »).
CLIENT_ORIGIN=

# Base PostgreSQL (Neon, Supabase, Aiven…). Elle conserve les salons en cours, les dessins
# et les parties terminées. Laisse vide pour tout garder en mémoire (parfait pour développer :
# le jeu fonctionne, mais l'historique disparaît au redémarrage).
#   Exemple Neon : postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Chiffrement de la connexion à la base : require (défaut) | verify (vérifie aussi le certificat) | disable
DATABASE_SSL=require

# Nombre de jours pendant lesquels les parties terminées et leurs dessins sont conservés.
GAME_RETENTION_DAYS=30

# Dossier du site compilé à servir par le serveur (mode « tout-en-un »).
# Par défaut, `client/dist` est détecté automatiquement s'il existe.
CLIENT_DIST=
